{
  "expo": {
    "name": "ARGON APP",
    "slug": "ARGON-starter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/argon-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.ARGON-starter.ARGON-starter",
      "adaptiveIcon": {
        "foregroundImage": "./assets/argon-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/argon-icon.png"
    },
    "plugins": [
      "expo-router"
      
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
